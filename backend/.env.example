# ====================================================================
# TACTICAL CORE - Environment Configuration
# ====================================================================

# Application
APP_NAME=Tactical Core
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-string

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=sqlite:///./storage/database/tactical_core.db
DATABASE_ECHO=false

# Storage Paths
STORAGE_ROOT=./storage
AUDIO_PATH=./storage/audio
VIDEO_PATH=./storage/video
ATTACHMENTS_PATH=./storage/attachments
LOGS_PATH=./storage/logs
CACHE_PATH=./storage/cache

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MESSAGE_QUEUE_SIZE=1000

# Radio Module
RADIO_ENABLED=false
RADIO_SAMPLE_RATE=16000
RADIO_CHANNELS=1
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Signal Module
SIGNAL_ENABLED=false
SIGNAL_CLI_PATH=/usr/local/bin/signal-cli
SIGNAL_USERNAME=+1234567890
SIGNAL_GROUP_NAME=Tactical Core

# Video/Camera Module
MEDIA_MTX_ENABLED=false
MEDIA_MTX_URL=http://localhost:8888
CAMERA_STREAM_TIMEOUT=300

# AI Module
AI_ENABLED=true
AI_MODEL_PATH=./models
AI_CONFIDENCE_THRESHOLD=0.7
AI_SUMMARY_LENGTH=200

# MQTT Module
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=tactical

# Plugin System
PLUGINS_ENABLED=true
PLUGINS_PATH=./plugins
PLUGIN_SCAN_INTERVAL=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./storage/logs/tactical_core.log
LOG_MAX_SIZE=104857600
LOG_BACKUP_COUNT=10

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tactical-core@example.com

# External APIs
TAK_ENABLED=false
TAK_HOST=tak.example.com
TAK_PORT=8087
